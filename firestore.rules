rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================
    // COLECCIONES PÚBLICAS (LECTURA)
    // ============================================================
    
    // Menús - Cualquiera puede leer y escribir (temporal hasta implementar Firebase Auth)
    match /menus/{branchId} {
      allow read, write: if true;
    }
    
    // Horarios - Cualquiera puede leer y escribir (temporal hasta implementar Firebase Auth)
    match /schedules/{scheduleId} {
      allow read, write: if true;
    }
    
    // Configuración fuera de horario - Cualquiera puede leer y escribir (temporal hasta implementar Firebase Auth)
    match /afterHoursSettings/{branch} {
      allow read, write: if true;
    }
    
    // ============================================================
    // COLECCIONES PÚBLICAS (LECTURA Y ESCRITURA LIMITADA)
    // ============================================================
    
    // Pedidos - Cualquiera puede crear y leer, admin puede actualizar/eliminar (temporal hasta Firebase Auth)
    match /orders/{orderId} {
      allow create, read, update, delete: if true;
    }
    
    // Clientes (CRM) - Cualquiera puede crear y leer, admin puede actualizar/eliminar (temporal hasta Firebase Auth)
    match /customers/{phone} {
      allow create, read, update, delete: if true;
    }
    
    // Cupones - Cualquiera puede leer y gestionar (temporal hasta Firebase Auth)
    match /coupons/{couponId} {
      allow read, write, delete: if true;
    }
    
    // Uso de cupones - Cualquiera puede crear y gestionar (temporal hasta Firebase Auth)
    match /coupon_usage/{usageId} {
      allow create, read, update, delete: if true;
    }
    
    // ============================================================
    // COLECCIONES PRIVADAS (SOLO ADMIN)
    // ============================================================
    
    // Domiciliarios - Cualquiera puede gestionar (temporal hasta Firebase Auth)
    match /deliveryPersons/{personId} {
      allow read, write, delete: if true;
    }
    
    // Contadores diarios - Cualquiera puede gestionar (temporal hasta Firebase Auth)
    match /dailyCounters/{counterId} {
      allow read, write, delete: if true;
    }
    
    // ============================================================
    // REGLA DE SEGURIDAD ADICIONAL
    // ============================================================
    
    // Prevenir eliminación masiva de colecciones
    match /{document=**} {
      allow delete: if request.auth != null && request.resource != null;
    }
  }
}